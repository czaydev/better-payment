{
  "name": "better-payment-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter better-payment build",
    "build:web": "pnpm --filter web build",
    "test": "pnpm --filter better-payment test",
    "changeset": "changeset",
    "version": "node scripts/version-packages.mjs",
    "release": "pnpm build && changeset publish",
    "lint": "pnpm --filter better-payment lint",
    "typecheck": "pnpm --filter better-payment typecheck",
    "version-packages": "node scripts/version-packages.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "overrides": {
      "minimatch@^9": "^9.0.7"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
