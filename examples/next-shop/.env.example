# Copy this file to .env.local (git-ignored) and keep the values empty for the
# default demo. Every value below is a placeholder, not a credential.
#
# Empty IYZICO_* values select MockProvider: the whole flow runs without an
# account, without network access to a provider and without real money.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# The /admin login compares its form field with this key. The example's default
# is demo-admin; change it or wire real session auth (see README).
DEMO_ADMIN_KEY=demo-admin
