{
  "name": "better-payment",
  "version": "0.10.0",
  "description": "Unified payment gateway library for Turkish payment providers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.mjs",
      "require": "./dist/plugins/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.mjs",
      "require": "./dist/next/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.mjs",
      "require": "./dist/express/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "import": "./dist/hono/index.mjs",
      "require": "./dist/hono/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "import": "./dist/fastify/index.mjs",
      "require": "./dist/fastify/index.js"
    },
    "./elysia": {
      "types": "./dist/elysia/index.d.ts",
      "import": "./dist/elysia/index.mjs",
      "require": "./dist/elysia/index.js"
    },
    "./react-router": {
      "types": "./dist/react-router/index.d.ts",
      "import": "./dist/react-router/index.mjs",
      "require": "./dist/react-router/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest tests/unit",
    "test:integration": "vitest tests/integration",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "test:edge": "vitest run --config vitest.edge.config.ts",
    "test:edge-smoke": "node scripts/edge-smoke.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "size": "node scripts/check-size.mjs"
  },
  "keywords": [
    "payment",
    "gateway",
    "iyzico",
    "paytr",
    "akbank",
    "parampos",
    "kuveytturk",
    "turkey",
    "turkish",
    "payment-gateway",
    "typescript",
    "payment-provider",
    "e-commerce",
    "online-payment",
    "3d-secure",
    "nodejs",
    "nextjs",
    "react-router",
    "remix",
    "edge",
    "cloudflare-workers",
    "deno"
  ],
  "author": "Better Pay Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czaydev/better-payment.git",
    "directory": "packages/better-payment"
  },
  "bugs": {
    "url": "https://github.com/czaydev/better-payment/issues"
  },
  "homepage": "https://better-payment.czaylabs.com",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@edge-runtime/vm": "^5.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.22",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^4.0.1",
    "elysia": "^1.4.30",
    "esbuild": "0.27.7",
    "eslint": "^8.54.0",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "hono": "^4.13.9",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.1"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
