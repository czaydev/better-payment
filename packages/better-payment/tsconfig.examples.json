{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "better-payment": [
        "src/index.ts"
      ],
      "better-payment/client": [
        "src/client/index.ts"
      ],
      "better-payment/testing": [
        "src/testing/index.ts"
      ],
      "better-payment/plugins": [
        "src/plugins/index.ts"
      ],
      "better-payment/next": [
        "src/adapters/next.ts"
      ],
      "better-payment/express": [
        "src/adapters/express.ts"
      ],
      "better-payment/hono": [
        "src/adapters/hono.ts"
      ],
      "better-payment/fastify": [
        "src/adapters/fastify.ts"
      ],
      "better-payment/elysia": [
        "src/adapters/elysia.ts"
      ]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false
  },
  "include": [
    "examples/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
